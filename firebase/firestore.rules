
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================
    // HELPER FUNCTIONS
    // ============================

    function isSignedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasUserProfile() {
      return isSignedIn() && exists(userPath());
    }

    function userData() {
      return get(userPath()).data;
    }

    function isParent() {
      return hasUserProfile()
        && userData().role == 'parent';
    }

    function isSchoolStaff() {
      return hasUserProfile()
        && userData().role in [
          'schoolAdmin',
          'classTeacher',
          'subjectTeacher',
          'monitor'
        ]
        && userData().schoolId is string
        && userData().schoolId.size() > 0;
    }

    function isSchoolAdmin() {
      return isSchoolStaff()
        && userData().role == 'schoolAdmin';
    }

    function staffBelongsToSchool(schoolId) {
      return isSchoolStaff()
        && userData().schoolId == schoolId;
    }

    function isParentLinkedToStudent(studentId) {
      return isParent()
        && exists(
          /databases/$(database)/documents/parent_child_links/$(request.auth.uid + '_' + studentId)
        )
        && get(
          /databases/$(database)/documents/parent_child_links/$(request.auth.uid + '_' + studentId)
        ).data.status == 'approved';
    }

    function teacherBelongsToSchool(teacherId, schoolId) {
      return exists(
          /databases/$(database)/documents/users/$(teacherId)
        )
        && get(
          /databases/$(database)/documents/users/$(teacherId)
        ).data.schoolId == schoolId
        && get(
          /databases/$(database)/documents/users/$(teacherId)
        ).data.role in ['classTeacher', 'subjectTeacher']
        && get(
          /databases/$(database)/documents/users/$(teacherId)
        ).data.isActive != false;
    }

    function subjectBelongsToSchool(subjectId, schoolId) {
      return exists(
          /databases/$(database)/documents/subjects/$(subjectId)
        )
        && get(
          /databases/$(database)/documents/subjects/$(subjectId)
        ).data.schoolId == schoolId
        && get(
          /databases/$(database)/documents/subjects/$(subjectId)
        ).data.isActive == true;
    }

    function sectionBelongsToSchool(sectionId, schoolId, classId) {
      return exists(
          /databases/$(database)/documents/sections/$(sectionId)
        )
        && get(
          /databases/$(database)/documents/sections/$(sectionId)
        ).data.schoolId == schoolId
        && get(
          /databases/$(database)/documents/sections/$(sectionId)
        ).data.classId == classId;
    }

    function classBelongsToSchool(classId, schoolId) {
      return exists(
          /databases/$(database)/documents/classes/$(classId)
        )
        && get(
          /databases/$(database)/documents/classes/$(classId)
        ).data.schoolId == schoolId;
    }

    function validAssignment(data) {
      return data.schoolId == userData().schoolId
        && data.teacherId is string
        && data.classId is string
        && data.sectionId is string
        && data.subjectId is string
        && teacherBelongsToSchool(data.teacherId, data.schoolId)
        && subjectBelongsToSchool(data.subjectId, data.schoolId)
        && classBelongsToSchool(data.classId, data.schoolId)
        && sectionBelongsToSchool(
          data.sectionId,
          data.schoolId,
          data.classId
        );
    }

    // ============================
    // USERS
    // ============================

    match /users/{userId} {

      // Parent signup only.
      // Staff accounts must be created by trusted functions.
      allow create:
        if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'parent';

      // Users can read their own profile.
      // School staff can read profiles belonging to their school.
      allow read:
        if isSignedIn()
        && (
          request.auth.uid == userId
          || (
            isSchoolStaff()
            && resource.data.schoolId == userData().schoolId
          )
        );

      // Users cannot change their own role or school.
      allow update:
        if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.schoolId == resource.data.schoolId;

      allow delete: if false;
    }

    // ============================
    // STUDENTS
    // ============================

    match /students/{studentId} {

      // Parents can read approved linked students.
      // Staff can read students from their own school.
      allow read:
        if (
          isParent()
          && isParentLinkedToStudent(studentId)
        )
        || (
          isSchoolStaff()
          && resource.data.schoolId == userData().schoolId
        );

      allow create:
        if isSchoolAdmin()
        && request.resource.data.schoolId == userData().schoolId;

      allow update:
        if isSchoolAdmin()
        && resource.data.schoolId == userData().schoolId
        && request.resource.data.schoolId == userData().schoolId;

      allow delete:
        if isSchoolAdmin()
        && resource.data.schoolId == userData().schoolId;
    }

    // ============================
    // PARENT-CHILD LINKS
    // ============================

    match /parent_child_links/{linkId} {

      allow read:
        if isSignedIn()
        && resource.data.parentId == request.auth.uid;

      // Link creation and approval use trusted functions.
      allow create, update, delete: if false;
    }

    // ============================
    // NOTIFICATIONS
    // ============================

    match /notifications/{notificationId} {

      allow read:
        if isParent()
        && resource.data.parentId == request.auth.uid;

      allow update:
        if isParent()
        && resource.data.parentId == request.auth.uid
        && request.resource.data.parentId == resource.data.parentId
        && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(['isRead']);

      allow create, delete: if false;
    }

    // ============================
    // SUBJECTS
    // ============================

    match /subjects/{subjectId} {

      allow read:
        if isSchoolStaff()
        && resource.data.schoolId == userData().schoolId;

      allow create:
        if isSchoolAdmin()
        && request.resource.data.schoolId == userData().schoolId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.isActive == true;

      allow update:
        if isSchoolAdmin()
        && resource.data.schoolId == userData().schoolId
        && request.resource.data.schoolId == userData().schoolId;

      allow delete:
        if isSchoolAdmin()
        && resource.data.schoolId == userData().schoolId;
    }

    // ============================
    // STAFF COLLECTION
    // ============================

    match /staff/{staffId} {

      allow read:
        if isSchoolStaff()
        && resource.data.schoolId == userData().schoolId;

      // Staff accounts must be managed by trusted backend functions.
      allow create, update, delete: if false;
    }

    // ============================
    // TEACHER ASSIGNMENTS
    // ============================

    match /teacherAssignments/{assignmentId} {

      allow read:
        if isSchoolStaff()
        && resource.data.schoolId == userData().schoolId;

      allow create:
        if isSchoolAdmin()
        && validAssignment(request.resource.data);

      // Allows same-school admins to change/reassign an assignment
      // while keeping all linked records valid.
      allow update:
        if isSchoolAdmin()
        && resource.data.schoolId == userData().schoolId
        && validAssignment(request.resource.data);

      allow delete:
        if isSchoolAdmin()
        && resource.data.schoolId == userData().schoolId;
    }

        // ============================
    // SCHOOL TESTS
    // ============================

    function hasActiveSubjectAssignment(sectionId, subjectId, schoolId) {
      return exists(
          /databases/$(database)/documents/teacherAssignments/$(sectionId + '_' + subjectId)
        )
        && get(
          /databases/$(database)/documents/teacherAssignments/$(sectionId + '_' + subjectId)
        ).data.schoolId == schoolId
        && get(
          /databases/$(database)/documents/teacherAssignments/$(sectionId + '_' + subjectId)
        ).data.sectionId == sectionId
        && get(
          /databases/$(database)/documents/teacherAssignments/$(sectionId + '_' + subjectId)
        ).data.subjectId == subjectId
        && get(
          /databases/$(database)/documents/teacherAssignments/$(sectionId + '_' + subjectId)
        ).data.teacherId == request.auth.uid
        && get(
          /databases/$(database)/documents/teacherAssignments/$(sectionId + '_' + subjectId)
        ).data.isActive == true;
    }

    function validTestData(data) {
      return isSchoolStaff()
        && data.schoolId == userData().schoolId
        && data.title is string
        && data.title.size() > 0
        && data.sectionId is string
        && data.subjectId is string
        && data.totalMarks is number
        && data.totalMarks > 0
        && data.passingMarks is number
        && data.passingMarks >= 0
        && data.passingMarks <= data.totalMarks
        && (
          isSchoolAdmin()
          || (
            userData().role == 'subjectTeacher'
            && hasActiveSubjectAssignment(
              data.sectionId,
              data.subjectId,
              data.schoolId
            )
          )
        );
    }

    match /tests/{testId} {
      allow read: if isSchoolStaff()
        && resource.data.schoolId == userData().schoolId
        && (
          isSchoolAdmin()
          || (
            userData().role == 'subjectTeacher'
            && hasActiveSubjectAssignment(
              resource.data.sectionId,
              resource.data.subjectId,
              resource.data.schoolId
            )
          )
        );

      allow create: if validTestData(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid;

      allow update: if validTestData(request.resource.data)
        && resource.data.schoolId == userData().schoolId
        && (
          isSchoolAdmin()
          || (
            userData().role == 'subjectTeacher'
            && hasActiveSubjectAssignment(
              resource.data.sectionId,
              resource.data.subjectId,
              resource.data.schoolId
            )
          )
        );

      allow delete: if isSchoolAdmin()
        && resource.data.schoolId == userData().schoolId;
    }

    // ============================
    // STUDENT MARKS
    // ============================

    function validStudentMark(data) {
      return isSchoolStaff()
        && data.schoolId == userData().schoolId
        && data.studentId is string
        && data.examId is string
        && data.sectionId is string
        && data.subjectId is string
        && data.obtainedMarks is number
        && data.totalMarks is number
        && data.totalMarks > 0
        && data.obtainedMarks >= 0
        && data.obtainedMarks <= data.totalMarks
        && exists(
          /databases/$(database)/documents/tests/$(data.examId)
        )
        && get(
          /databases/$(database)/documents/tests/$(data.examId)
        ).data.schoolId == data.schoolId
        && get(
          /databases/$(database)/documents/tests/$(data.examId)
        ).data.sectionId == data.sectionId
        && get(
          /databases/$(database)/documents/tests/$(data.examId)
        ).data.subjectId == data.subjectId
        && (
          isSchoolAdmin()
          || (
            userData().role == 'subjectTeacher'
            && data.enteredBy == request.auth.uid
            && hasActiveSubjectAssignment(
              data.sectionId,
              data.subjectId,
              data.schoolId
            )
          )
        );
    }

    match /studentMarks/{markId} {
      allow read: if isSchoolStaff()
        && resource.data.schoolId == userData().schoolId
        && (
          isSchoolAdmin()
          || (
            userData().role == 'subjectTeacher'
            && hasActiveSubjectAssignment(
              resource.data.sectionId,
              resource.data.subjectId,
              resource.data.schoolId
            )
          )
        );

      allow create: if validStudentMark(request.resource.data);

      allow update: if validStudentMark(request.resource.data)
        && resource.data.schoolId == userData().schoolId
        && resource.data.studentId == request.resource.data.studentId
        && resource.data.examId == request.resource.data.examId;

      allow delete: if isSchoolAdmin()
        && resource.data.schoolId == userData().schoolId;
    }
  }
}
